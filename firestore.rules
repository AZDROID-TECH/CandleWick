rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userDocId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['auth_uid', 'user_id'])
        && request.resource.data.auth_uid == request.auth.uid
        && request.resource.data.user_id is int;

      allow update: if request.auth != null
        && request.resource.data.user_id == resource.data.user_id
        && (
          (
            resource.data.keys().hasAll(['auth_uid'])
            && resource.data.auth_uid == request.auth.uid
            && request.resource.data.auth_uid == resource.data.auth_uid
          )
          ||
          (
            !resource.data.keys().hasAny(['auth_uid'])
            && request.resource.data.auth_uid == request.auth.uid
          )
        );

      allow delete: if false;
    }
  }
}

