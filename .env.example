# =============================================================
# Candle Wick — Nümunə env faylı. Dəyərləri .env-də doldurun.
# .env git-ignore edilib; sirlər ORAYA yazılır, buraya YOX.
# =============================================================

# --- İstemci (Firebase Web SDK) — VITE_* dəyərləri istemci bundle-a düşür (PUBLIC) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Reklam blok id-ləri (Adsgram) — istemci tərəfli, public ---
VITE_TELEGRAM_BLOCK_ID=
VITE_TELEGRAM_BLOCK_ID_2X=

# --- Backend rejimi ---
# 0 = köhnə rejim (birbaşa Firestore, anonim auth).
# 1 = backend rejimi (Custom Token + server-otoriter skor). Yalnız deploy + sirlər hazır olanda 1 et.
VITE_USE_BACKEND=0
# API əsas ünvanı — Vercel-də boş saxlayın (frontend və /api eyni origin).
VITE_API_BASE=

# =============================================================
# --- SERVER-ONLY sirlər (YALNIZ Vercel Environment Variables-də) ---
# Bunlar ASLA VITE_* prefiksi ilə yazılmır və istemci bundle-a düşmür.
# =============================================================
# Telegram bot token (BotFather-dan) — initData HMAC doğrulaması üçün.
# TELEGRAM_BOT_TOKEN=
# Firebase service-account JSON-u (tək sətir string kimi) — Admin SDK üçün.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
